# Copy to .env and fill in. docker-compose refuses to start if any of these are missing, which is
# deliberate — a deploy that silently falls back to a publicly-known password is worse than one that
# fails loudly.
#
#   cp .env.example .env
#   openssl rand -base64 48      # use the output for JWT_SECRET

# --- Database ---------------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=finflow
MYSQL_USER=finflow
# Must match SPRING_DATASOURCE_PASSWORD below.
MYSQL_PASSWORD=

# --- Backend ----------------------------------------------------------------------------------
SPRING_DATASOURCE_USERNAME=finflow
SPRING_DATASOURCE_PASSWORD=

# Signs every login token. Anyone holding this can mint a session for any account, so treat it like
# a production database password: unique per environment, never committed, rotated if exposed.
# Rotating it invalidates all existing sessions — everyone signs in again.
JWT_SECRET=

# 86400000 ms = 24h. Shorter is safer; this is a personal-finance app, not a chat app.
JWT_EXPIRATION=86400000

# Origins allowed to call the API. Add your phone address (Tailscale https://<mac>.<tailnet>.ts.net).
# Single-quoted: the [*] would otherwise be expanded when the file is sourced.
CORS_ALLOWED_ORIGINS='http://localhost:[*],http://127.0.0.1:[*]'
